{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "Parameters": {
    "Workspace": {
      "type": "string"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/f05271b6-26a5-49cf-ad73-4a202fba6eb6')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/f05271b6-26a5-49cf-ad73-4a202fba6eb6')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2021-03-01-preview",
      "properties": {
        "status": "Available",
        "triggerThreshold": 0,
        "tactics": [
          "InitialAccess"
        ],
        "entityMappings": [
          {
            "entityType": "IP",
            "fieldMappings": [
              {
                "columnName": "IPCustomEntity",
                "identifier": "Address"
              }
            ]
          },
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "columnName": "AccountCustomEntity",
                "identifier": "Name"
              }
            ]
          }
        ],
        "severity": "Medium",
        "query": "DuoAuthentication_CL\n| where Result =~ 'success'\n| where isnotempty(AccessDeviceIp)\n| summarize dvc_ip = make_set(AccessDeviceIp) by UserName\n| join (DuoAuthentication_CL\n        | where Result =~ 'success') on UserName\n| where dvc_ip !has AccessDeviceIp\n| extend IPCustomEntity = AccessDeviceIp, AccountCustomEntity = UserName\n",
        "queryPeriod": "14d",
        "triggerOperator": "gt",
        "description": "'Detects new access device.'\n",
        "name": "Cisco Duo - New access device",
        "queryFrequency": "1h"
      }
    }
  ]
}
