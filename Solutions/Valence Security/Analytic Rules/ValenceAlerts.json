{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "Parameters": {
    "Workspace": {
      "type": "string"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/d944d564-b6fa-470d-b5ab-a1a141878c5e')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/d944d564-b6fa-470d-b5ab-a1a141878c5e')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2021-03-01-preview",
      "properties": {
        "name": "Valence Security Alerts",
        "alertDetailsOverride": {
          "alertDescriptionFormat": "{{summaryLine}}",
          "alertDisplayNameFormat": "Valence Alert: {{alertType}}",
          "alertSeverityColumnName": "sentinelSeverity",
          "alertDynamicProperties": []
        },
        "query": "ValenceAlerts_CL\n",
        "tactics": [],
        "queryPeriod": "5m",
        "severity": "High",
        "triggerThreshold": 0,
        "queryFrequency": "5m",
        "status": "Available",
        "triggerOperator": "gt",
        "customDetails": {
          "ValenceAlertType": "alertType",
          "ValenceStatus": "status",
          "ValenceCreatedTS": "creationTimestamp",
          "ValenceSeverity": "severity",
          "ValenceSummary": "summaryLine"
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "description": "'Valence Security Alerts'\n"
      }
    }
  ]
}
