{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "Parameters": {
    "Workspace": {
      "type": "string"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/b5e805a7-a6b5-4af5-9a23-a5ea92b744f5')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/b5e805a7-a6b5-4af5-9a23-a5ea92b744f5')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2021-03-01-preview",
      "properties": {
        "entityMappings": [
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "columnName": "UserLogin_s",
                "identifier": "Name"
              }
            ]
          },
          {
            "entityType": "IP",
            "fieldMappings": [
              {
                "columnName": "SourceIP_s",
                "identifier": "Address"
              }
            ]
          }
        ],
        "name": "Pulumi Cloud - Organization membership change",
        "severity": "Low",
        "queryFrequency": "1h",
        "triggerOperator": "gt",
        "tactics": [
          "Persistence"
        ],
        "query": "PulumiAuditLogs_CL\n| where Event_s in (\"member-added\", \"member-removed\", \"member-role-changed\")\n",
        "status": "Available",
        "description": "Identifies changes to Pulumi Cloud organization membership, including members being added, removed, or having their roles changed. These events track access control changes to the infrastructure management platform and should correspond to expected administrative activity.\n",
        "triggerThreshold": 0,
        "queryPeriod": "1h"
      }
    }
  ]
}
