{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "Parameters": {
    "Workspace": {
      "type": "string"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/bc489413-747f-41c7-bfe7-0ab66ded788e')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/bc489413-747f-41c7-bfe7-0ab66ded788e')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2021-03-01-preview",
      "properties": {
        "description": "Identifies deletion of a Pulumi stack. Stack deletion is a destructive operation that removes the stack's infrastructure state, and may be legitimate maintenance or unauthorized activity.\n",
        "severity": "Medium",
        "name": "Pulumi Cloud - Stack deleted",
        "entityMappings": [
          {
            "fieldMappings": [
              {
                "identifier": "Name",
                "columnName": "UserLogin_s"
              }
            ],
            "entityType": "Account"
          },
          {
            "fieldMappings": [
              {
                "identifier": "Address",
                "columnName": "SourceIP_s"
              }
            ],
            "entityType": "IP"
          }
        ],
        "status": "Available",
        "query": "PulumiAuditLogs_CL\n| where Event_s == \"stack-deleted\"\n",
        "triggerOperator": "gt",
        "triggerThreshold": 0,
        "queryFrequency": "1h",
        "tactics": [
          "Impact"
        ],
        "queryPeriod": "1h"
      }
    }
  ]
}
