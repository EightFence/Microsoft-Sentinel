{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "Parameters": {
    "Workspace": {
      "type": "string"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/0199390c-e96d-4119-b25c-83257f3c4738')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/0199390c-e96d-4119-b25c-83257f3c4738')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2021-03-01-preview",
      "properties": {
        "entityMappings": [
          {
            "entityType": "IP",
            "fieldMappings": [
              {
                "columnName": "SourceIP_s",
                "identifier": "Address"
              }
            ]
          }
        ],
        "name": "Pulumi Cloud - Excessive authentication failures",
        "severity": "Medium",
        "queryFrequency": "1h",
        "triggerOperator": "gt",
        "tactics": [
          "CredentialAccess"
        ],
        "query": "PulumiAuditLogs_CL\n| where Event_s == \"user-login-failed\"\n| summarize FailCount = count(), StartTime = min(TimeGenerated), EndTime = max(TimeGenerated) by SourceIP_s\n| where FailCount > 5\n",
        "status": "Available",
        "description": "Identifies more than five failed Pulumi Cloud login attempts (user-login-failed events) from a single IP address within a one-hour window. This may indicate a brute force attack or an attempt to use compromised credentials.\n",
        "triggerThreshold": 0,
        "queryPeriod": "1h"
      }
    }
  ]
}
