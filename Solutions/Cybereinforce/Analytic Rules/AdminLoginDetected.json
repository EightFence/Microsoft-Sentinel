{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "Parameters": {
    "Workspace": {
      "type": "string"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/65bc5f1d-d29d-4729-a5a6-d9614b0900e0')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/65bc5f1d-d29d-4729-a5a6-d9614b0900e0')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2021-03-01-preview",
      "properties": {
        "tactics": [
          "InitialAccess"
        ],
        "severity": "Informational",
        "queryPeriod": "30m",
        "query": "CybereinforceCTE_CL\n| where EventType == \"auth.login\"\n| extend AccountName = tostring(split(Actor, \"@\")[0]), UPNSuffix = tostring(split(Actor, \"@\")[1])\n| project TimeGenerated, TenantId, Actor, AccountName, UPNSuffix, Severity, Category, Source\n",
        "name": "CTE - Admin Login Detected",
        "entityMappings": [
          {
            "fieldMappings": [
              {
                "identifier": "Name",
                "columnName": "AccountName"
              },
              {
                "identifier": "UPNSuffix",
                "columnName": "UPNSuffix"
              }
            ],
            "entityType": "Account"
          }
        ],
        "description": "An administrator logged into the Cybereinforce console.\n",
        "queryFrequency": "30m",
        "triggerThreshold": 0,
        "triggerOperator": "gt"
      }
    }
  ]
}
