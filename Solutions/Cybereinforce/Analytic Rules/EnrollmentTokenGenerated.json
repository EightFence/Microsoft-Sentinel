{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "Parameters": {
    "Workspace": {
      "type": "string"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/0be1ebaf-36f8-49a6-a3b6-56491ccfda7f')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/0be1ebaf-36f8-49a6-a3b6-56491ccfda7f')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2021-03-01-preview",
      "properties": {
        "queryFrequency": "1h",
        "name": "CTE - Enrollment Token Generated",
        "description": "An enrollment token was generated for onboarding a new device.\n",
        "query": "CybereinforceCTE_CL\n| where EventType == \"token.generated\"\n| extend AccountName = tostring(split(Actor, \"@\")[0]), UPNSuffix = tostring(split(Actor, \"@\")[1])\n| project TimeGenerated, TenantId, Actor, AccountName, UPNSuffix, Severity, Category, Source\n",
        "severity": "Informational",
        "queryPeriod": "1h",
        "tactics": [
          "Persistence"
        ],
        "triggerOperator": "gt",
        "entityMappings": [
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "columnName": "AccountName",
                "identifier": "Name"
              },
              {
                "columnName": "UPNSuffix",
                "identifier": "UPNSuffix"
              }
            ]
          }
        ],
        "triggerThreshold": 0
      }
    }
  ]
}
