{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "Parameters": {
    "Workspace": {
      "type": "string"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/8da040d4-bd02-47ae-86b5-db527a8b4f18')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/8da040d4-bd02-47ae-86b5-db527a8b4f18')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2021-03-01-preview",
      "properties": {
        "entityMappings": [
          {
            "entityType": "URL",
            "fieldMappings": [
              {
                "identifier": "Url",
                "columnName": "Url"
              }
            ]
          }
        ],
        "severity": "Medium",
        "description": "Identifies Deep & Dark Web intelligence matches that are takedown eligible.\nUses NetcraftDdwIntelligence_Latest so the same MatchUuid alerts once per window.\n",
        "eventGroupingSettings": {
          "aggregationKind": "AlertPerResult"
        },
        "triggerOperator": "gt",
        "status": "Available",
        "tactics": [
          "Reconnaissance",
          "ResourceDevelopment"
        ],
        "name": "Netcraft DDW Intelligence - Takedown eligible match",
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "Netcraft DDW - takedown eligible {{IntelligenceType}} ({{DisplayValue}})",
          "alertDescriptionFormat": "Match {{DisplayValue}} ({{MatchUuid}}) is takedown eligible with priority {{Priority}}."
        },
        "queryPeriod": "4h",
        "query": "NetcraftDdwIntelligence_Latest\n| where IngestedAt > ago(15m)\n| where TakedownEligible == true\n| project\n    TimeGenerated,\n    EventId,\n    MatchUuid,\n    GroupUuid,\n    Subject,\n    IntelligenceType,\n    DisplayValue,\n    Priority,\n    Acknowledged,\n    TakedownEligible,\n    MatchSource,\n    Url,\n    DdwUrl,\n    Rule\n",
        "customDetails": {
          "Acknowledged": "Acknowledged",
          "GroupUuid": "GroupUuid",
          "MatchUuid": "MatchUuid",
          "TakedownEligible": "TakedownEligible"
        },
        "queryFrequency": "15m",
        "triggerThreshold": 0
      }
    }
  ]
}
