{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "Parameters": {
    "Workspace": {
      "type": "string"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/f2cd0583-da5f-4edc-a4ad-1a237643c228')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/f2cd0583-da5f-4edc-a4ad-1a237643c228')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2021-03-01-preview",
      "properties": {
        "queryFrequency": "15m",
        "status": "Available",
        "alertDetailsOverride": {
          "alertDescriptionFormat": "Takedown {{TakedownId}} waiting for customer ({{ActionRequired}}). Status: {{Status}}.",
          "alertDisplayNameFormat": "Netcraft Takedown waiting - {{TakedownId}}"
        },
        "triggerThreshold": 0,
        "entityMappings": [
          {
            "entityType": "URL",
            "fieldMappings": [
              {
                "identifier": "Url",
                "columnName": "ThreatUrl"
              }
            ]
          },
          {
            "entityType": "IP",
            "fieldMappings": [
              {
                "identifier": "Address",
                "columnName": "ThreatIp"
              }
            ]
          },
          {
            "entityType": "DNS",
            "fieldMappings": [
              {
                "identifier": "DomainName",
                "columnName": "ThreatDomain"
              }
            ]
          }
        ],
        "tactics": [
          "ResourceDevelopment",
          "DefenseEvasion"
        ],
        "description": "Identifies Netcraft Takedown records where action is waiting on the customer\n(`EventType == \"takedown\"` and `ActionRequired` is not `no`).\n",
        "query": "NetcraftTakedown_Unique\n| where IngestedAt > ago(15m)\n| where EventType == \"takedown\"\n| where isnotempty(ActionRequired) and ActionRequired != \"no\"\n| extend\n    ThreatUrl = iff(Threat matches regex @\"(?i)^https?://\", Threat, \"\"),\n    ThreatIp = iff(isnotempty(parse_ipv4(Threat)) or isnotempty(parse_ipv6(Threat)), Threat, \"\")\n| extend\n    ThreatDomain = iff(isempty(ThreatUrl) and isempty(ThreatIp) and Threat !has \"@\" and Threat matches regex @\"^[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$\", Threat, \"\")\n| project\n    TimeGenerated,\n    EventId,\n    Subject,\n    TakedownId,\n    GroupId,\n    AttackType,\n    Threat,\n    ThreatUrl,\n    ThreatIp,\n    ThreatDomain,\n    Status,\n    ActionRequired,\n    IsAuthorized,\n    IsEscalated,\n    IsMaliciousDomain,\n    IsMaliciousHostname\n",
        "customDetails": {
          "GroupId": "GroupId",
          "AttackType": "AttackType",
          "IsMaliciousDomain": "IsMaliciousDomain",
          "IsAuthorized": "IsAuthorized",
          "IsMaliciousHostname": "IsMaliciousHostname",
          "IsEscalated": "IsEscalated",
          "Threat": "Threat"
        },
        "name": "Netcraft Takedown - Waiting for customer",
        "eventGroupingSettings": {
          "aggregationKind": "AlertPerResult"
        },
        "queryPeriod": "4h",
        "triggerOperator": "gt",
        "severity": "High"
      }
    }
  ]
}
