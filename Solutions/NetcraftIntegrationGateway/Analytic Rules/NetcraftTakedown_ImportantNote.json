{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "Parameters": {
    "Workspace": {
      "type": "string"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/0a0416c5-277a-4a2b-9815-7b457fdffd81')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/0a0416c5-277a-4a2b-9815-7b457fdffd81')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2021-03-01-preview",
      "properties": {
        "description": "Identifies important notes added, updated, or deleted on Netcraft takedowns or takedown groups.\n",
        "severity": "Medium",
        "name": "Netcraft Takedown - Important note changed",
        "status": "Available",
        "query": "NetcraftTakedown_Unique\n| where IngestedAt > ago(15m)\n| where EventType in (\"takedown-important-note\", \"takedown-important-note-updated\", \"takedown-important-note-deleted\", \"group-important-note\", \"group-important-note-updated\", \"group-important-note-deleted\")\n| project\n    TimeGenerated,\n    EventId,\n    EventType,\n    Subject,\n    EntityType,\n    TakedownId,\n    GroupId,\n    NoteId,\n    NoteBody\n",
        "triggerOperator": "gt",
        "eventGroupingSettings": {
          "aggregationKind": "AlertPerResult"
        },
        "customDetails": {
          "TakedownId": "TakedownId",
          "GroupId": "GroupId",
          "NoteId": "NoteId",
          "EventType": "EventType",
          "EntityType": "EntityType"
        },
        "triggerThreshold": 0,
        "alertDetailsOverride": {
          "alertDescriptionFormat": "Important note ({{NoteId}}) on {{Subject}}: {{NoteBody}}",
          "alertDisplayNameFormat": "Netcraft Takedown note - {{Subject}}"
        },
        "queryFrequency": "15m",
        "tactics": [
          "ResourceDevelopment"
        ],
        "queryPeriod": "4h"
      }
    }
  ]
}
