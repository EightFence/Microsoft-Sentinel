{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "Parameters": {
    "Workspace": {
      "type": "string"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/6de7eb0b-693c-4d4a-a263-d047f88f167f')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/6de7eb0b-693c-4d4a-a263-d047f88f167f')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2021-03-01-preview",
      "properties": {
        "tactics": [
          "ResourceDevelopment"
        ],
        "status": "Available",
        "name": "Netcraft Takedown - Resolved",
        "triggerOperator": "gt",
        "description": "Identifies Netcraft Takedown records whose status is `resolved`\n(`EventType == \"takedown\"`). The gateway status enum is lowercase.\nRaises an alert only; no incident is created.\n",
        "severity": "Informational",
        "incidentConfiguration": {
          "createIncident": false
        },
        "eventGroupingSettings": {
          "aggregationKind": "AlertPerResult"
        },
        "query": "NetcraftTakedown_Unique\n| where IngestedAt > ago(15m)\n| where EventType == \"takedown\"\n| where Status == \"resolved\"\n| extend\n    ThreatUrl = iff(Threat matches regex @\"(?i)^https?://\", Threat, \"\"),\n    ThreatIp = iff(isnotempty(parse_ipv4(Threat)) or isnotempty(parse_ipv6(Threat)), Threat, \"\")\n| extend\n    ThreatDomain = iff(isempty(ThreatUrl) and isempty(ThreatIp) and Threat !has \"@\" and Threat matches regex @\"^[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$\", Threat, \"\")\n| project\n    TimeGenerated,\n    EventId,\n    Subject,\n    TakedownId,\n    GroupId,\n    AttackType,\n    Threat,\n    ThreatUrl,\n    ThreatIp,\n    ThreatDomain,\n    Status,\n    IsMaliciousDomain,\n    IsMaliciousHostname,\n    IsAuthorized,\n    IsEscalated\n",
        "customDetails": {
          "IsMaliciousDomain": "IsMaliciousDomain",
          "IsMaliciousHostname": "IsMaliciousHostname",
          "IsAuthorized": "IsAuthorized",
          "IsEscalated": "IsEscalated",
          "AttackType": "AttackType",
          "GroupId": "GroupId"
        },
        "queryFrequency": "15m",
        "queryPeriod": "4h",
        "alertDetailsOverride": {
          "alertDescriptionFormat": "Takedown {{TakedownId}} ({{AttackType}}) is resolved. Threat: {{Threat}}.",
          "alertDisplayNameFormat": "Netcraft Takedown resolved - {{TakedownId}}"
        },
        "triggerThreshold": 0,
        "entityMappings": [
          {
            "fieldMappings": [
              {
                "identifier": "Url",
                "columnName": "ThreatUrl"
              }
            ],
            "entityType": "URL"
          },
          {
            "fieldMappings": [
              {
                "identifier": "Address",
                "columnName": "ThreatIp"
              }
            ],
            "entityType": "IP"
          },
          {
            "fieldMappings": [
              {
                "identifier": "DomainName",
                "columnName": "ThreatDomain"
              }
            ],
            "entityType": "DNS"
          }
        ]
      }
    }
  ]
}
