{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "Parameters": {
    "Workspace": {
      "type": "string"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/f788b740-86af-46b2-b986-c059c5e5b908')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/f788b740-86af-46b2-b986-c059c5e5b908')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2021-03-01-preview",
      "properties": {
        "triggerThreshold": 0,
        "triggerOperator": "gt",
        "description": "Identifies high-priority Deep & Dark Web intelligence matches that are still unacknowledged (`Acknowledged == false`).\nUses NetcraftDdwIntelligence_Latest so the same MatchUuid alerts once per window.\n",
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "Netcraft DDW - unacknowledged high {{IntelligenceType}} ({{DisplayValue}})",
          "alertDescriptionFormat": "High-priority {{IntelligenceType}} match {{MatchUuid}} for {{DisplayValue}} is unacknowledged."
        },
        "query": "NetcraftDdwIntelligence_Latest\n| where IngestedAt > ago(15m)\n| where Priority == \"high\"\n| where Acknowledged == false\n| project\n    TimeGenerated,\n    EventId,\n    MatchUuid,\n    GroupUuid,\n    Subject,\n    IntelligenceType,\n    DisplayValue,\n    Priority,\n    Acknowledged,\n    TakedownEligible,\n    MatchSource,\n    Url,\n    DdwUrl,\n    Rule\n",
        "queryFrequency": "15m",
        "tactics": [
          "Reconnaissance",
          "CredentialAccess"
        ],
        "eventGroupingSettings": {
          "aggregationKind": "AlertPerResult"
        },
        "queryPeriod": "4h",
        "entityMappings": [
          {
            "entityType": "URL",
            "fieldMappings": [
              {
                "identifier": "Url",
                "columnName": "Url"
              }
            ]
          }
        ],
        "name": "Netcraft DDW Intelligence - Unacknowledged high priority",
        "severity": "High",
        "status": "Available",
        "customDetails": {
          "GroupUuid": "GroupUuid",
          "MatchUuid": "MatchUuid",
          "TakedownEligible": "TakedownEligible",
          "Acknowledged": "Acknowledged"
        }
      }
    }
  ]
}
