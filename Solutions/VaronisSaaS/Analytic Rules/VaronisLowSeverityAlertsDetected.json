{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "Parameters": {
    "Workspace": {
      "type": "string"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/9b1f3e7a-6c42-4d18-a5e9-2b7f8c0d4e61')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/9b1f3e7a-6c42-4d18-a5e9-2b7f8c0d4e61')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2021-03-01-preview",
      "properties": {
        "queryFrequency": "5m",
        "name": "Varonis - Low severity alerts detected",
        "alertDetailsOverride": {
          "alertDescriptionFormat": "Varonis detected activity for policy {{ThreatDetectionPolicyName_s}} in category {{AlertCategory_s}}. Users: {{UserNames_s}}.",
          "alertDisplayNameFormat": "Varonis alert: {{ThreatDetectionPolicyName_s}} ({{AlertSeverity_s}})"
        },
        "eventGroupingSettings": {
          "aggregationKind": "AlertPerResult"
        },
        "description": "'Identifies low-severity alerts generated by Varonis that indicate lower-risk activity supporting ongoing analysis, threat correlation, and security monitoring.'\n",
        "incidentConfiguration": {
          "groupingConfiguration": {
            "lookbackDuration": "PT5H",
            "reopenClosedIncident": false,
            "matchingMethod": "AllEntities",
            "enabled": false
          },
          "createIncident": true
        },
        "severity": "Low",
        "queryPeriod": "5m",
        "customDetails": {
          "AlertCategory": "AlertCategory_s",
          "MitreTactic": "MitreTacticName_s",
          "VaronisAlertGuid": "AlertId_g",
          "EventsCount": "EventsCount_d",
          "Status": "Status_s"
        },
        "tactics": [
          "Collection",
          "Exfiltration"
        ],
        "triggerOperator": "gt",
        "query": "VaronisAlerts_CL\n| where AlertSeverity_s == \"Low\"\n",
        "entityMappings": [
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "columnName": "UserNames_s",
                "identifier": "FullName"
              },
              {
                "columnName": "UserSamAccountNames_s",
                "identifier": "Name"
              }
            ]
          },
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "columnName": "DeviceNames_s",
                "identifier": "HostName"
              }
            ]
          }
        ],
        "status": "Available",
        "triggerThreshold": 0
      }
    }
  ]
}
