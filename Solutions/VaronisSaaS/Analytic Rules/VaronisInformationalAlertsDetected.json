{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "Parameters": {
    "Workspace": {
      "type": "string"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/e5a7c93b-8d14-42f6-b7c0-3a9e1f6d5b28')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/e5a7c93b-8d14-42f6-b7c0-3a9e1f6d5b28')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2021-03-01-preview",
      "properties": {
        "queryPeriod": "5m",
        "incidentConfiguration": {
          "createIncident": true,
          "groupingConfiguration": {
            "enabled": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "reopenClosedIncident": false
          }
        },
        "tactics": [
          "Collection",
          "Exfiltration"
        ],
        "triggerThreshold": 0,
        "status": "Available",
        "description": "'Identifies informational alerts generated by Varonis that provide contextual signals supporting correlation, enrichment, and overall security visibility.'\n",
        "query": "VaronisAlertsV2_CL\n| where AlertSeverity_s == \"Informational\"\n",
        "queryFrequency": "5m",
        "name": "Varonis - Informational alerts detected",
        "eventGroupingSettings": {
          "aggregationKind": "AlertPerResult"
        },
        "entityMappings": [
          {
            "fieldMappings": [
              {
                "columnName": "UserNames_s",
                "identifier": "FullName"
              },
              {
                "columnName": "UserSamAccountNames_s",
                "identifier": "Name"
              }
            ],
            "entityType": "Account"
          },
          {
            "fieldMappings": [
              {
                "columnName": "DeviceNames_s",
                "identifier": "HostName"
              }
            ],
            "entityType": "Host"
          }
        ],
        "severity": "Informational",
        "alertDetailsOverride": {
          "alertDescriptionFormat": "Varonis detected activity for policy {{ThreatDetectionPolicyName_s}} in category {{AlertCategory_s}}. Users: {{UserNames_s}}.",
          "alertDisplayNameFormat": "Varonis alert: {{ThreatDetectionPolicyName_s}} ({{AlertSeverity_s}})"
        },
        "customDetails": {
          "EventsCount": "EventsCount_d",
          "VaronisAlertGuid": "AlertId_g",
          "MitreTactic": "MitreTacticName_s",
          "AlertCategory": "AlertCategory_s",
          "Status": "Status_s"
        },
        "triggerOperator": "gt"
      }
    }
  ]
}
