{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "Parameters": {
    "Workspace": {
      "type": "string"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/3c6be532-dfa0-42ee-87ea-cf3d9e6772bb')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/3c6be532-dfa0-42ee-87ea-cf3d9e6772bb')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2021-03-01-preview",
      "properties": {
        "query": "WhoisFreaksThreat_CL\n| where tostring(is_parked) in~ (\"t\", \"true\", \"1\")\n| summarize arg_max(TimeGenerated, *) by domain\n| project TimeGenerated, domain, threat_type, confidence, parked_reason, matched_pivots\n",
        "triggerThreshold": 0,
        "description": "Identifies threat-listed domains that are currently parked and may be used for staging. The feed reports parked state in the is_parked column as t or f.\n",
        "triggerOperator": "gt",
        "tactics": [
          "ResourceDevelopment"
        ],
        "queryPeriod": "6h",
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "entityMappings": [
          {
            "fieldMappings": [
              {
                "identifier": "DomainName",
                "columnName": "domain"
              }
            ],
            "entityType": "DNS"
          }
        ],
        "queryFrequency": "6h",
        "severity": "Medium",
        "name": "WhoisFreaks - parked threat domains",
        "status": "Available"
      }
    }
  ]
}
