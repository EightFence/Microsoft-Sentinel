{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "Parameters": {
    "Workspace": {
      "type": "string"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/0eb4df70-418e-4f7d-9b5a-cfe35034ec11')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/0eb4df70-418e-4f7d-9b5a-cfe35034ec11')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2021-03-01-preview",
      "properties": {
        "queryPeriod": "1h",
        "tactics": [
          "InitialAccess",
          "CommandAndControl"
        ],
        "triggerThreshold": 0,
        "status": "Available",
        "description": "Identifies high-confidence malware, phishing, and spam domains from WhoisFreaks threat feeds.\n",
        "query": "WhoisFreaksThreat_CL\n| where toint(confidence) >= 80 or confidence =~ \"high\"\n| summarize arg_max(TimeGenerated, *) by domain, threat_type\n| project TimeGenerated, domain, threat_type, confidence, first_seen, last_seen, is_parked, matched_pivots\n",
        "queryFrequency": "1h",
        "name": "WhoisFreaks - high confidence threat domains",
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "entityMappings": [
          {
            "fieldMappings": [
              {
                "columnName": "domain",
                "identifier": "DomainName"
              }
            ],
            "entityType": "DNS"
          }
        ],
        "severity": "High",
        "triggerOperator": "gt"
      }
    }
  ]
}
