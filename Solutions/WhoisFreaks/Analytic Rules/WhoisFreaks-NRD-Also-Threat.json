{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "Parameters": {
    "Workspace": {
      "type": "string"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/d2deed97-6c0c-4a57-95fd-675d3c6fb949')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/d2deed97-6c0c-4a57-95fd-675d3c6fb949')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2021-03-01-preview",
      "properties": {
        "entityMappings": [
          {
            "entityType": "DNS",
            "fieldMappings": [
              {
                "identifier": "DomainName",
                "columnName": "domain"
              }
            ]
          }
        ],
        "severity": "High",
        "description": "Identifies newly registered domains that are later observed in WhoisFreaks threat feeds.\n",
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "triggerOperator": "gt",
        "status": "Available",
        "tactics": [
          "InitialAccess",
          "ResourceDevelopment"
        ],
        "name": "WhoisFreaks - newly registered domain seen in threat feed",
        "queryPeriod": "7d",
        "query": "let nrd = union WhoisFreaksNRD_CL, WhoisFreaksNRDNoWhois_CL\n| where TimeGenerated > ago(7d)\n| distinct domain_name;\nWhoisFreaksThreat_CL\n| where TimeGenerated > ago(1d)\n| join kind=inner (nrd) on $left.domain == $right.domain_name\n| summarize arg_max(TimeGenerated, *) by domain, threat_type\n| project TimeGenerated, domain, threat_type, confidence, domain_name\n",
        "queryFrequency": "1h",
        "triggerThreshold": 0
      }
    }
  ]
}
