{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "Parameters": {
    "Workspace": {
      "type": "string"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/9d79f28f-5d1d-4ca8-b3d3-4ab5f5513e8d')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/9d79f28f-5d1d-4ca8-b3d3-4ab5f5513e8d')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2021-03-01-preview",
      "properties": {
        "queryFrequency": "1h",
        "tactics": [
          "ResourceDevelopment"
        ],
        "query": "union WhoisFreaksNRD_CL, WhoisFreaksNRDNoWhois_CL\n| where TimeGenerated > ago(1h)\n| summarize DomainCount=dcount(domain_name) by bin(TimeGenerated, 1h)\n| where DomainCount > 5000\n| project TimeGenerated, DomainCount\n",
        "triggerThreshold": 0,
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "triggerOperator": "gt",
        "queryPeriod": "1h",
        "name": "WhoisFreaks - burst of newly registered domains",
        "severity": "Low",
        "description": "Identifies unusually large NRD ingest volume that may indicate bulk registration campaigns.\n",
        "status": "Available"
      }
    }
  ]
}
