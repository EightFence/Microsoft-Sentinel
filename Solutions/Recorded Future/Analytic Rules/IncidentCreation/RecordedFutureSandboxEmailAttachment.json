{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "Parameters": {
    "Workspace": {
      "type": "string"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/a1b2c3d4-5678-90ab-cdef-222222222222')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/a1b2c3d4-5678-90ab-cdef-222222222222')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2021-03-01-preview",
      "properties": {
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "Malicious Email Attachment: {{FileName}} from {{EmailFrom}}",
          "alertDescriptionFormat": "_Recorded Future Sandbox - Malicious Email Attachment Detected_\n\n**Sandbox Score:** {{SandboxScore}}/100\n\n**Verdict:** {{SandboxVerdict}}\n\n**Sample ID:** {{SampleId}}\n\nA malicious file was detected in an email attachment. Review the full sandbox report and investigate the sender.\n"
        },
        "triggerThreshold": 0,
        "eventGroupingSettings": {
          "aggregationKind": "AlertPerResult"
        },
        "customDetails": {
          "SandboxVerdict": "SandboxVerdict",
          "SampleId": "SampleId",
          "EmailFrom": "EmailFrom",
          "SandboxScore": "SandboxScore",
          "FileName": "FileName",
          "Source": "Source",
          "EmailTo": "EmailTo"
        },
        "description": "'Creates incidents when Recorded Future Sandbox detects malicious files from Outlook email attachments'\n",
        "status": "Available",
        "tactics": [],
        "triggerOperator": "gt",
        "name": "Recorded Future Sandbox - Malicious Email Attachment",
        "query": "RecordedFutureSandboxResults_V2_CL\n| where TimeGenerated >= now(-1h)\n| where Source == \"OutlookAttachment\"\n| where toint(SandboxScore) >= 50\n",
        "incidentConfiguration": {
          "groupingConfiguration": {
            "groupByCustomDetails": [
              "EmailFrom"
            ],
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "1h",
            "matchingMethod": "Selected"
          },
          "createIncident": true
        },
        "queryFrequency": "1h",
        "queryPeriod": "1h",
        "severity": "High",
        "entityMappings": [
          {
            "entityType": "File",
            "fieldMappings": [
              {
                "identifier": "Name",
                "columnName": "FileName"
              }
            ]
          },
          {
            "entityType": "Mailbox",
            "fieldMappings": [
              {
                "identifier": "MailboxPrimaryAddress",
                "columnName": "EmailFrom"
              }
            ]
          }
        ]
      }
    }
  ]
}
