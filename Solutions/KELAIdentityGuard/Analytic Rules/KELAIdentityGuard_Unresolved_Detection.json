{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "Parameters": {
    "Workspace": {
      "type": "string"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/1399A2AA-F54D-4265-A405-3CCE11BE226C')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/1399A2AA-F54D-4265-A405-3CCE11BE226C')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2021-03-01-preview",
      "properties": {
        "name": "KELA Identity Guard Unresolved Incident",
        "query": "KELA_IdentityGuard_Incidents_CL\n| summarize arg_max(TimeGenerated, *) by incidentId\n| where status =~ 'UNRESOLVED'\n",
        "triggerOperator": "gt",
        "tactics": [
          "CredentialAccess",
          "InitialAccess"
        ],
        "description": "Identifies unresolved incidents ingested from the KELA Identity Guard API, regardless of their original severity.\n",
        "triggerThreshold": 0,
        "queryPeriod": "1h",
        "severity": "Medium",
        "queryFrequency": "1h",
        "entityMappings": [
          {
            "fieldMappings": [
              {
                "identifier": "Name",
                "columnName": "accountUserName"
              }
            ],
            "entityType": "Account"
          },
          {
            "fieldMappings": [
              {
                "identifier": "Url",
                "columnName": "link"
              }
            ],
            "entityType": "URL"
          }
        ],
        "status": "Available"
      }
    }
  ]
}
