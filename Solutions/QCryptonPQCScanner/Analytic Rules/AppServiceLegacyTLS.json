{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "Parameters": {
    "Workspace": {
      "type": "string"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/7f8e9d1c-2b3a-4e5f-6c7d-8a9b0c1d2e3f')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/7f8e9d1c-2b3a-4e5f-6c7d-8a9b0c1d2e3f')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2021-03-01-preview",
      "properties": {
        "severity": "Medium",
        "entityMappings": [
          {
            "fieldMappings": [
              {
                "identifier": "ResourceId",
                "columnName": "ResourceId"
              }
            ],
            "entityType": "AzureResource"
          },
          {
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "ResourceName"
              }
            ],
            "entityType": "Host"
          }
        ],
        "tactics": [
          "InitialAccess"
        ],
        "triggerOperator": "gt",
        "name": "App Service using TLS < 1.3",
        "query": "PQReadiness_CL\n| where TimeGenerated > ago(1d)\n| where AssetKind == \"tls-config\"\n| where ResourceType =~ \"microsoft.web/sites\"\n| where QuantumPosture in (\"vulnerable\", \"partial\")\n| project TimeGenerated, ResourceId, ResourceName, PostureReason, RiskScore, SubscriptionId, ResourceGroup\n| order by RiskScore desc\n",
        "queryFrequency": "1d",
        "triggerThreshold": 0,
        "status": "Available",
        "queryPeriod": "1d",
        "description": "An Azure App Service is configured to accept inbound TLS below 1.3. Only TLS 1.3 supports\nthe negotiation of hybrid PQ key exchange (X25519MLKEM768 etc.); legacy versions cannot be\nupgraded to PQ without a client protocol change.\n"
      }
    }
  ]
}
