{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "Parameters": {
    "Workspace": {
      "type": "string"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/6FBB40C8-2A65-460C-9E3E-2DDEC6BBCE54')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/6FBB40C8-2A65-460C-9E3E-2DDEC6BBCE54')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2021-03-01-preview",
      "properties": {
        "triggerOperator": "gt",
        "queryFrequency": "1h",
        "status": "Available",
        "description": "Identifies unresolved incidents ingested from the KELA Brand Control API, regardless of their original severity.\n",
        "name": "KELA Brand Control Unresolved Incident",
        "queryPeriod": "1h",
        "entityMappings": [
          {
            "fieldMappings": [
              {
                "columnName": "domainName",
                "identifier": "DomainName"
              }
            ],
            "entityType": "DNS"
          },
          {
            "fieldMappings": [
              {
                "columnName": "domainName",
                "identifier": "Url"
              }
            ],
            "entityType": "URL"
          }
        ],
        "severity": "Medium",
        "query": "KELA_BrandControl_Incidents_CL\n| summarize arg_max(TimeGenerated, *) by incidentId\n| where status =~ 'in_review'\n",
        "tactics": [
          "ResourceDevelopment",
          "InitialAccess"
        ],
        "triggerThreshold": 0
      }
    }
  ]
}
