{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "Parameters": {
    "Workspace": {
      "type": "string"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/f160411a-0351-41d5-bc44-53fc6b0ffc13')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/f160411a-0351-41d5-bc44-53fc6b0ffc13')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2021-03-01-preview",
      "properties": {
        "severity": "Medium",
        "triggerOperator": "gt",
        "entityMappings": [
          {
            "fieldMappings": [
              {
                "columnName": "email",
                "identifier": "FullName"
              },
              {
                "columnName": "username",
                "identifier": "Name"
              }
            ],
            "entityType": "Account"
          },
          {
            "fieldMappings": [
              {
                "columnName": "ip",
                "identifier": "Address"
              }
            ],
            "entityType": "IP"
          },
          {
            "fieldMappings": [
              {
                "columnName": "domain",
                "identifier": "DomainName"
              }
            ],
            "entityType": "DNS"
          },
          {
            "fieldMappings": [
              {
                "columnName": "source_url",
                "identifier": "Url"
              }
            ],
            "entityType": "URL"
          }
        ],
        "status": "Available",
        "queryFrequency": "1h",
        "tactics": [
          "ResourceDevelopment",
          "InitialAccess",
          "CredentialAccess"
        ],
        "description": "Identifies unresolved incidents ingested from the KELA Monitor API, regardless of their original severity.\n",
        "alertDetailsOverride": {
          "alertDescriptionFormat": "Incident ID {{id}} detected for category '{{incidentType}}'.",
          "alertDisplayNameFormat": "KELA Monitor: {{sub_type_description}} (Severity {{severity}})"
        },
        "triggerThreshold": 0,
        "queryPeriod": "1h",
        "name": "KELA Monitor Unresolved Incident",
        "query": "KELA_Monitor_Incidents_CL\n| summarize arg_max(TimeGenerated, *) by id\n| where severity >= 1\n",
        "customDetails": {
          "IncidentType": "incidentType",
          "SubType": "sub_type_description",
          "BotID": "bot_id",
          "Actor": "author",
          "Service": "service"
        }
      }
    }
  ]
}
